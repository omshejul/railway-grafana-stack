{
  "uid": "cfuv5biy8t8g0d",
  "orgID": 1,
  "folderUID": "shared-observability",
  "ruleGroup": "Availability",
  "title": "Monitored service is down",
  "condition": "B",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "grafana_prometheus",
      "model": {
        "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
        "editorMode": "code",
        "expr": "min by (project, service) (up{project!=\"\"})",
        "instant": true,
        "intervalMs": 1000,
        "legendFormat": "{{project}} / {{service}}",
        "maxDataPoints": 43200,
        "range": false,
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": { "from": 0, "to": 0 },
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [{
          "evaluator": { "params": [1], "type": "lt" },
          "operator": { "type": "and" },
          "query": { "params": ["B"] },
          "reducer": { "params": [], "type": "last" },
          "type": "query"
        }],
        "datasource": { "type": "__expr__", "uid": "__expr__" },
        "expression": "A",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "B",
        "type": "threshold"
      }
    }
  ],
  "noDataState": "Alerting",
  "execErrState": "Alerting",
  "for": "5m",
  "keep_firing_for": "0s",
  "annotations": {
    "summary": "{{ $labels.project }} / {{ $labels.service }} is down",
    "description": "Prometheus cannot scrape {{ $labels.project }} / {{ $labels.service }} for five minutes."
  },
  "labels": {
    "severity": "critical",
    "signal_kind": "service_unavailable",
    "team": "platform"
  },
  "isPaused": false
}
