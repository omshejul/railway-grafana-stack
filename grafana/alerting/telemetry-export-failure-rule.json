{
  "uid": "telemetry-export-failure",
  "orgID": 1,
  "folderUID": "shared-observability",
  "ruleGroup": "Errors",
  "title": "Telemetry export failed",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "queryType": "range",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "grafana_lokiq",
      "model": {
        "datasource": { "type": "loki", "uid": "grafana_lokiq" },
        "editorMode": "code",
        "expr": "sum by (project_name, service_name, environment_name) (count_over_time({project_name!=\"\"} |~ `^Failed to export span batch code:` [5m]))",
        "intervalMs": 1000,
        "legendFormat": "{{project_name}} / {{service_name}}",
        "maxDataPoints": 43200,
        "queryType": "range",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": { "from": 0, "to": 0 },
      "datasourceUid": "__expr__",
      "model": {
        "datasource": { "type": "__expr__", "uid": "__expr__" },
        "expression": "A",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "queryType": "",
      "relativeTimeRange": { "from": 0, "to": 0 },
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [
          {
            "evaluator": { "params": [0], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["C"] },
            "reducer": { "params": [], "type": "last" },
            "type": "query"
          }
        ],
        "datasource": { "type": "__expr__", "uid": "__expr__" },
        "expression": "B",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "C",
        "type": "threshold"
      }
    }
  ],
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "0s",
  "keep_firing_for": "0s",
  "annotations": {
    "summary": "Telemetry export failed in {{ $labels.project_name }} / {{ $labels.service_name }}",
    "description": "Grafana detected {{ $values.B.Value }} failed span export batch(es) for {{ $labels.project_name }} / {{ $labels.service_name }} in the last five minutes. Application behavior may be healthy while trace coverage is degraded."
  },
  "labels": {
    "severity": "warning",
    "signal_kind": "telemetry_export_failure",
    "team": "platform"
  },
  "isPaused": false
}
